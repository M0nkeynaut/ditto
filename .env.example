# Copy to .env and adjust. All values are optional (defaults shown).

# Host ports for the honeypot. 22/23 catch the most scans but collide with a
# host SSH on 22 - change them or forward at your firewall. See README.
COWRIE_SSH_PORT=22
COWRIE_TELNET_PORT=23
TARPIT_PORT=2222

# Fake hostname the honeypot shows to attackers.
COWRIE_HOSTNAME=srv-web01

# Dashboard port (http://<host>:<port>/).
DITTO_WEB_PORT=8080

# How often the collector rebuilds the JSON (seconds) and how far it looks back.
DITTO_INTERVAL=120
DITTO_LOOKBACK_DAYS=7
